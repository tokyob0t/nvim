(import-macros {: map!} :macros)

(map! [nv] :<C-Left> :b {:silent true :noremap true})
(map! [nv] :<C-Right> :w {:silent true :noremap true})
(map! [n] :<S-Up> :<Up> {:silent true :noremap true})
(map! [ni] :<S-Down> :<Down> {:silent true :noremap true})
(map! [v] :<S-Up> ":m '<-2<CR>gv=gv" {:silent true :noremap true})
(map! [v] :<S-Down> ":m '>+1<CR>gv=gv" {:silent true :noremap true})
(map! [n] :<esc> :<esc><cmd>noh<CR> {:silent true :noremap true})
(map! [n] :<leader>q vim.cmd.q {:silent true :noremap true})
(map! [n] :<leader>i :o {:silent true :noremap true})
(map! [n] :<leader>I :O {:silent true :noremap true})
(map! [n] "<leader><Tab>[" vim.cmd.bprev {:silent true :noremap true})
(map! [n] "<leader><Tab>]" vim.cmd.bnext {:silent true :noremap true})
(map! [n] :<leader><Tab>d vim.cmd.bdelete {:silent true :noremap true})
(map! [nv] ";" ":" {:silent true :noremap true})
