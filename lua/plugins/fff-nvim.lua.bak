        -- set('file_info_section', '#ff0000')
    end,
    lazy = false,
    opts = {
        prompt = '   ',
        title = 'Find Files',
        prompt_vim_mode = true,
        enable_home_dir_scanning = false,
        layout = {
            width = 0.87,
            height = 0.8,
            prompt_position = 'top',
            preview_position = 'right',
            preview_size = 0.55,
            min_list_height = 10,
            show_scrollbar = true,
            anchor = 'center',
        },
        preview = {
            enabled = true,
            max_size = 10 * 1024 * 1024,
            chunk_size = 8192,
            binary_file_threshold = 1024,
            imagemagick_info_format_str = '%m: %wx%h, %[colorspace], %q-bit',
            line_numbers = false,
            cursorlineopt = 'both',
            wrap_lines = false,
            filetypes = {
                svg = { wrap_lines = true },
                markdown = { wrap_lines = true },
                text = { wrap_lines = true },
            },
        },
        grep = {
            location_format = '',
            modes = { 'fuzzy' },
        },
        debug = {
            enabled = false,
            show_scores = false,
            show_file_info = false,
        },
    },
    keys = {
        {
            '<leader>.',
            function()
                require('fff').find_files()
            end,
        },

        {
            '<leader>,',
            function()
                require('fff').live_grep()
            end,
        },
    },
